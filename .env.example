# Run `pnpm setup:env` to create .env with generated local secrets. Never commit .env.
# Staging and production use separate values, stored in Render and Vercel, not in files.

# --- Local stack (docker-compose) ---
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
AUTH_JWT_SECRET=
AUTH_JWT_KEYS=

# --- API and worker (server only) ---
DATABASE_URL=postgresql://lifeos:CHANGE_ME@127.0.0.1:54322/lifeos
TEST_DATABASE_URL=postgresql://lifeos:CHANGE_ME@127.0.0.1:54322/lifeos_test
REDIS_URL=redis://127.0.0.1:56379
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
WEB_ORIGIN=http://localhost:5173
API_PORT=4000
RATE_LIMIT_PER_MINUTE=300
ADMIN_REQUIRE_MFA=
SENTRY_DSN=

# --- AI: mock needs no key. Use openai with a key and model to go live. ---
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
AI_MONTHLY_TOKEN_BUDGET=200000
FEATURE_AI=true

# --- Push notifications (private key is server only) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Local seed ---
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=

# --- Public values only. Everything prefixed VITE_ ships to the browser. ---
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=local-anon
VITE_VAPID_PUBLIC_KEY=
VITE_SENTRY_DSN=
