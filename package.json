{
  "name": "lifeos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "setup:env": "node infra/scripts/setup-env.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:validate": "prisma validate",
    "db:seed": "prisma db seed",
    "check:deps": "node infra/scripts/check-deps.mjs",
    "check": "pnpm check:deps && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "guide:record": "sh infra/scripts/make-guide-gifs.sh"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "dotenv": "^17.0.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "prettier": "^3.6.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "@lifeos/contracts": "workspace:*",
    "@lifeos/db": "workspace:*",
    "@eslint/js": "^9.39.0",
    "@lifeos/config": "workspace:*"
  }
}
